cmake_minimum_required(VERSION 3.18)

if((NOT FILES AND NOT MODULE_DIR) OR NOT LIB_DIR)
    message(FATAL_ERROR "macos_bundle_libs.cmake needs -DFILES=<executables> or -DMODULE_DIR=<script cache folder>, and -DLIB_DIR=<folder>")
endif()

if(MODULE_DIR)
    file(GLOB _modules LIST_DIRECTORIES FALSE "${MODULE_DIR}/script*.so" "${MODULE_DIR}/script*.dylib")
    if(NOT _modules)
        message(FATAL_ERROR "macos_bundle_libs: no compiled scripts in ${MODULE_DIR}")
    endif()
    list(APPEND FILES ${_modules})
endif()

file(MAKE_DIRECTORY "${LIB_DIR}")
get_filename_component(LIB_DIR "${LIB_DIR}" REALPATH)

set(_search_dirs "")
foreach(_d IN ITEMS /opt/homebrew/lib /usr/local/lib)
    if(IS_DIRECTORY "${_d}")
        list(APPEND _search_dirs "${_d}")
    endif()
endforeach()

function(_is_system path out)
    if(path MATCHES "^/usr/lib/" OR path MATCHES "^/System/")
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(_run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _rc EQUAL 0)
        list(JOIN ARGN " " _cmd)
        message(FATAL_ERROR "macos_bundle_libs: '${_cmd}' failed:\n${_out}${_err}")
    endif()
endfunction()

function(_deps file out)
    execute_process(COMMAND otool -L "${file}" OUTPUT_VARIABLE _text RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
        message(FATAL_ERROR "macos_bundle_libs: otool -L ${file} failed")
    endif()
    execute_process(COMMAND otool -D "${file}" OUTPUT_VARIABLE _id_text)
    string(REPLACE "\n" ";" _id_lines "${_id_text}")
    set(_id "")
    list(LENGTH _id_lines _n)
    if(_n GREATER 1)
        list(GET _id_lines 1 _id)
        string(STRIP "${_id}" _id)
    endif()
    string(REPLACE "\n" ";" _lines "${_text}")
    list(REMOVE_AT _lines 0)
    set(_result "")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^[ \t]+(.+) \\(compatibility version")
            set(_dep "${CMAKE_MATCH_1}")
            if(NOT _dep STREQUAL _id)
                list(APPEND _result "${_dep}")
            endif()
        endif()
    endforeach()
    set(${out} "${_result}" PARENT_SCOPE)
endfunction()

set(_queue "")
foreach(_f IN LISTS FILES)
    get_filename_component(_real "${_f}" REALPATH)
    list(APPEND _queue "${_real}")
    get_filename_component(_dir "${_real}" DIRECTORY)
    set("_origin_${_real}" "${_dir}")
endforeach()

set(_touched "")
while(_queue)
    list(POP_FRONT _queue _file)
    get_filename_component(_file_dir "${_file}" DIRECTORY)
    set(_in_lib FALSE)
    if(_file_dir STREQUAL LIB_DIR)
        set(_in_lib TRUE)
    endif()
    _deps("${_file}" _list)
    foreach(_dep IN LISTS _list)
        _is_system("${_dep}" _system)
        if(_system)
            continue()
        endif()
        get_filename_component(_name "${_dep}" NAME)
        if(_dep MATCHES "^@executable_path/lib/" OR (_in_lib AND _dep MATCHES "^@loader_path/" AND EXISTS "${LIB_DIR}/${_name}"))
            continue()
        endif()

        set(_source "")
        if(IS_ABSOLUTE "${_dep}")
            set(_source "${_dep}")
        else()
            set(_origin "${_origin_${_file}}")
            foreach(_d IN LISTS _origin _search_dirs)
                if(_d AND EXISTS "${_d}/${_name}")
                    set(_source "${_d}/${_name}")
                    break()
                endif()
            endforeach()
        endif()
        if(NOT _source OR NOT EXISTS "${_source}")
            message(FATAL_ERROR "macos_bundle_libs: ${_file} needs ${_dep}, which can't be found")
        endif()

        set(_copy "${LIB_DIR}/${_name}")
        if(NOT EXISTS "${_copy}")
            get_filename_component(_real_source "${_source}" REALPATH)
            get_filename_component(_source_dir "${_source}" DIRECTORY)
            _run(cp -f "${_real_source}" "${_copy}.part")
            _run(chmod u+w "${_copy}.part")
            file(RENAME "${_copy}.part" "${_copy}")
            _run(install_name_tool -id "@executable_path/lib/${_name}" "${_copy}")
            set("_origin_${_copy}" "${_source_dir}")
            list(APPEND _queue "${_copy}")
            list(APPEND _touched "${_copy}")
        endif()

        if(_in_lib)
            set(_new "@loader_path/${_name}")
        else()
            set(_new "@executable_path/lib/${_name}")
        endif()
        _run(install_name_tool -change "${_dep}" "${_new}" "${_file}")
        list(APPEND _touched "${_file}")
    endforeach()
endwhile()

list(REMOVE_DUPLICATES _touched)
foreach(_f IN LISTS _touched)
    _run(codesign --force --sign - "${_f}")
endforeach()

list(LENGTH _touched _count)
message(STATUS "macos_bundle_libs: ${_count} file(s) now use the libraries in ${LIB_DIR}")
