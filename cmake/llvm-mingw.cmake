set(CMAKE_SYSTEM_NAME Windows)

if(NOT LLVM_MINGW_TARGET)
    set(LLVM_MINGW_TARGET "$ENV{LLVM_MINGW_TARGET}")
endif()
if(NOT LLVM_MINGW_TARGET)
    set(LLVM_MINGW_TARGET x86_64-w64-mingw32)
endif()
string(REGEX MATCH "^[^-]+" CMAKE_SYSTEM_PROCESSOR "${LLVM_MINGW_TARGET}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES LLVM_MINGW_TARGET)

set(CMAKE_C_COMPILER ${LLVM_MINGW_TARGET}-clang)
set(CMAKE_CXX_COMPILER ${LLVM_MINGW_TARGET}-clang++)
set(CMAKE_RC_COMPILER ${LLVM_MINGW_TARGET}-windres)

if(DEFINED ENV{LLVM_MINGW_DEPS})
    list(APPEND CMAKE_FIND_ROOT_PATH "$ENV{LLVM_MINGW_DEPS}")
    list(APPEND CMAKE_PREFIX_PATH "$ENV{LLVM_MINGW_DEPS}")
endif()

set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|i686)$")
    find_program(LLVM_MINGW_WINE NAMES wine wine64)
    if(LLVM_MINGW_WINE)
        set(CMAKE_CROSSCOMPILING_EMULATOR "${LLVM_MINGW_WINE}")
    endif()
endif()
