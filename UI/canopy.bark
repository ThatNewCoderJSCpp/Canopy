$bg = #1e1e2e;
$surface = #181825;
$panel = #11111b;
$line = #313244;
$hover = #2a2b3c;
$text = #cdd6f4;
$muted = #9399b2;
$accent = #a6e3a1;
$blue = #89b4fa;
$warn = #f9e2af;
$error = #f38ba8;
$git-yellow = #e2c08d;
$git-green = #73c991;
$git-red = #f14c4c;

body {
    size: 75vwidth 80vheight;
    background: $bg;
    color: $text;
    accent-color: $blue;
    font-size: 13px;
    padding: 0;
}

#shell {
    gap: 0;
    flex: 1;
}

#sidebar {
    user-select: none;
    background: $surface;
}

.area {
    gap: 0;
    border-color: $line;
    border-width: 1px;
}

#aside {
    background: $surface;
}

#view-explorer {
    padding: 6px 0 0 0;
    overflow: hidden;
    gap: 0;
}

.layout-box {
    gap: 0;
    flex: 1;
}

.layout-fill {
    flex: 1;
}

.splitter-x {
    width: 6px;
    cursor: col-resize;
    user-select: none;

    &:hover {
        background: $blue;
    }
}

.splitter-y {
    height: 6px;
    cursor: row-resize;
    user-select: none;

    &:hover {
        background: $blue;
    }
}

.splitter-x.dragging,
.splitter-y.dragging {
    background: $blue;
}

body.resizing-x,
body.resizing-x * {
    cursor: col-resize !important;
}

body.resizing-y,
body.resizing-y * {
    cursor: row-resize !important;
}

body.moving-tab,
body.moving-tab * {
    cursor: move !important;
}

.area-tabs.drop-here {
    background: $hover;
}

.sidebar-header {
    padding: 0 12px;
}

.sidebar-title {
    color: $muted;
    font-size: 11px;
    font-weight: bold;
    margin: 0 0 6px 0;
}

.sidebar-title.section {
    padding: 0 12px;
    margin: 10px 0 4px 0;
}

.workspace {
    font-weight: bold;
    padding: 0 12px;
    margin: 0 0 6px 0;
}

.sidebar-actions {
    padding: 0 12px;
    gap: 6px;
    margin: 0 0 8px 0;

    input_file {
        padding: 4px 10px;
        margin: 0;
        font-size: 12px;
    }
}

#explorer {
    flex: 1;
    overflow: auto;
    padding: 0 4px;
}

#explorer item {
    display: row;
    gap: 5px;
}

.twisty {
    color: $muted;
    font-size: 11px;
    padding: 1px 0 0 0;
}

.file-icon {
    margin: 1px 0 0 0;
}

#explorer item,
#recent item {
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;

    &:hover {
        background: $hover;
    }
}

#explorer item.folder {
    color: $blue;
}

#explorer item.open {
    background: $line;
}

#explorer item.selected {
    background: $hover;
    border-color: $blue;
    border-width: 1px;
}

#explorer item.root {
    color: $text;
    font-weight: bold;
}

#explorer item.cut {
    opacity: 0.5;
}

#explorer item.drop-target {
    background: $hover;
    border-color: $accent;
    border-width: 1px;
}

#recent {
    max-height: 120px;
    overflow: auto;
    padding: 0 4px;
}

#recent item {
    color: $muted;
}

.sidebar-footer {
    padding: 8px 12px;

    button {
        margin: 0;
        padding: 4px 10px;
        font-size: 12px;
    }
}

#main {
    padding: 0;
    gap: 0;
}

#tab-bar {
    user-select: none;
    background: $surface;
    gap: 0;
    height: 36px;
}

#tabs {
    gap: 0;
    flex: 1;
}

.tab {
    gap: 6px;
    padding: 9px 12px;
    color: $muted;
    cursor: pointer;

    &:hover {
        background: $hover;
    }
}

.tab.active {
    background: $bg;
    color: $text;
}

.tab.preview .tab-name {
    font-style: italic;
}

.tab-close {
    color: $muted;
}

#tab-actions {
    width: 150px;
    gap: 6px;
    padding: 5px 8px;
    justify-content: end;

    button {
        margin: 0;
        padding: 3px 12px;
        font-size: 12px;
    }

    button.primary {
        background: $accent;
        color: $panel;
        border-color: $accent;
    }
}

#editors {
    flex: 1;
    padding: 0;
}

#welcome {
    padding: 28px 32px;
    height: 100%;
    overflow: auto;
}

.muted {
    color: $muted;
}

code {
    background: $line;
    border-radius: 3px;
}

input_code.editor {
    height: 100%;
    margin: 0;
    border-radius: 0;
    background: $bg;
    font-size: 14px;
    padding: 4px 0;
}

.hidden {
    display: none;
}

#panel {
    background: $panel;
}

.area-tabs,
#panel-tabs {
    user-select: none;
    gap: 18px;
    padding: 6px 14px 0 14px;
    height: 30px;
    overflow-x: auto;
    overflow-y: hidden;
}

.panel-tab {
    color: $muted;
    font-size: 11px;
    white-space: nowrap;
    cursor: pointer;
    padding: 2px 0 4px 0;

    &:hover {
        color: $text;
    }
}

.panel-tab.active {
    color: $text;
    font-weight: bold;
}

.panel-view {
    display: none;
    flex: 1;
    padding: 8px 14px;
    overflow: auto;
}

.panel-view.active {
    display: block;
}

#output-log {
    margin: 0;
    font-size: 12px;
}

.out-chunk {
    margin: 0;
    font-size: 12px;
}

#view-terminal {
    padding: 0;
    overflow: hidden;
}

#terminal {
    height: 100%;
    gap: 0;
}

#terminal-bar {
    gap: 6px;
    padding: 4px 10px;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.terminal-picker {
    min-width: 160px;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

#terminal-views {
    flex: 1;
    gap: 0;
    padding: 0;
}

#terminal-empty {
    padding: 10px 14px;
}

terminal.terminal-view {
    flex: 1;
    margin: 0;
    padding: 2px 0 0 10px;
    background: $panel;
    color: $text;
    caret-color: $text;
    accent-color: $blue;
    font-size: 13px;
}

.problem {
    color: $warn;
    margin: 0 0 4px 0;
    cursor: pointer;
}

.problem.error {
    color: $error;
}

.ok {
    color: $accent;
    margin: 0;
}

#status {
    user-select: none;
    background: $line;
    padding: 3px 12px;
    font-size: 12px;
    justify-content: space-between;
    height: 22px;
}

.status-left,
.status-right {
    gap: 16px;
}

.status-right {
    justify-content: end;
    align-items: center;
}

.status-select {
    min-width: 120px;
    padding: 0 8px;
    margin: 0;
    font-size: 12px;
    background: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;

    &:hover {
        background: $hover;
    }
}

.settings-page {
    height: 100%;
    gap: 0;
}

.settings-page.hidden {
    display: none;
}

.settings-nav {
    user-select: none;
    width: 170px;
    background: $surface;
    padding: 14px 0 10px 0;
    border-color: $line;
    border-width: 1px;
}

.settings-nav-title {
    color: $muted;
    font-size: 11px;
    font-weight: bold;
    padding: 0 16px 8px 16px;
}

.settings-nav-item {
    margin: 0;
    padding: 5px 16px;
    cursor: pointer;
    color: $muted;

    &:hover {
        background: $hover;
        color: $text;
    }
}

.settings-nav-item.active {
    color: $text;
    background: $line;
}

.settings-nav-spacer {
    flex: 1;
}

.settings-nav-file {
    margin: 0;
    padding: 4px 16px;
    color: $blue;
    font-size: 12px;
    cursor: pointer;
}

.settings-nav-path {
    margin: 0;
    padding: 0 16px;
    color: $muted;
    font-size: 11px;
}

.settings-body {
    flex: 1;
    height: 100%;
    overflow: auto;
    padding: 14px 24px;
}

.settings-heading {
    margin: 0 0 4px 0;
}

.settings-note {
    color: $muted;
    font-size: 12px;
    margin: 0 0 10px 0;
}

.settings-group {
    margin: 16px 0 4px 0;
    color: $blue;
    font-size: 13px;
}

.setting {
    gap: 16px;
    padding: 8px 0;
}

.setting-text {
    flex: 1;
}

.setting-name {
    font-weight: bold;
}

.setting-help {
    color: $muted;
    font-size: 12px;
}

.setting-where {
    gap: 10px;
}

.setting-source {
    color: $accent;
    font-size: 11px;
}

.setting-reset {
    color: $blue;
    font-size: 11px;
    cursor: pointer;
}

.shortcut-row.clash .setting-name {
    color: $error;
}

.shortcut-clash {
    color: $error;
    font-size: 12px;
}

.shortcut-fixed {
    color: $muted;
    font-family: monospace;
    padding: 0 8px;
}

.shortcut-record {
    width: 150px;
}

.shortcut-record.recording {
    color: $accent;
    border-color: $accent;
}

.shortcut-banner {
    padding: 8px 12px;
    margin: 4px 0 8px 0;
    border-color: $error;
    border-width: 1px;
    border-radius: 6px;
}

.shortcut-banner-title {
    color: $error;
    font-weight: bold;
}

.shortcut-banner-item {
    margin: 4px 0 0 0;
    font-size: 12px;
    cursor: pointer;
}

.setting-choices {
    gap: 12px;
}

.theme-row {
    gap: 8px;
    margin: 0 0 8px 0;
}

.theme-card {
    flex: 1;
    padding: 7px 10px;
    border-color: $line;
    border-width: 1px;
    border-radius: 6px;
    cursor: pointer;

    &:hover {
        border-color: $muted;
    }
}

.theme-card.active {
    border-color: $blue;
    border-width: 2px;
}

.theme-card.filler {
    border-width: 0;
    cursor: default;
}

.theme-name {
    font-size: 12px;
    font-weight: bold;
}

.theme-swatches {
    gap: 3px;
    margin: 5px 0 0 0;
}

.theme-swatch {
    width: 12px;
    height: 8px;
    border-radius: 2px;
}

.language-chips {
    gap: 6px;
    margin: 8px 0 10px 0;
}

.language-chip {
    display: inline-block;
    padding: 3px 10px;
    border-color: $line;
    border-width: 1px;
    border-radius: 11px;
    font-size: 12px;
    cursor: pointer;

    &:hover {
        border-color: $muted;
    }
}

.language-chip.active {
    background: $blue;
    color: $bg;
    border-color: $blue;
}

.highlight-split {
    gap: 16px;
}

.color-list {
    flex: 1;
    min-width: 300px;
}

.color-row {
    gap: 6px;
    padding: 3px 6px;
    border-radius: 4px;

    &:hover {
        background: $hover;
    }
}

.color-row.lit {
    background: $line;
}

.color-input {
    width: 104px;
    font-size: 12px;
}

.style-toggle {
    width: 22px;
    margin: 3px 0 0 0;
    padding: 1px 0;
    text-align: center;
    font-size: 12px;
    color: $muted;
    border-color: $line;
    border-width: 1px;
    border-radius: 3px;
    cursor: pointer;

    &:hover {
        color: $text;
    }
}

.style-toggle.on {
    color: $text;
    background: $line;
    border-color: $blue;
}

.style-toggle.bold {
    font-weight: bold;
}

.style-toggle.italic {
    font-style: italic;
}

.style-toggle.underline {
    text-decoration: underline;
}

.style-toggle.strikethrough {
    text-decoration: line-through;
}

.color-text {
    flex: 1;
    padding: 0 0 0 4px;
}

.color-name {
    display: inline-block;
    font-size: 13px;
    padding: 0 6px;
    border-radius: 3px;
}

.color-what {
    color: $muted;
    font-size: 11px;
}

.color-clear {
    width: 18px;
    margin: 3px 0 0 0;
    text-align: center;
    color: $muted;
    cursor: pointer;

    &:hover {
        color: $error;
    }
}

.color-reset-all {
    color: $blue;
    font-size: 12px;
    margin: 8px 6px;
    cursor: pointer;
}

.preview-side {
    flex: 1;
}

.hl-preview {
    height: 440px;
    margin: 0 0 8px 0;
    border-radius: 6px;
    padding: 6px 0;
}

.theme-actions {
    gap: 8px;
    margin: 4px 0 6px 0;
}

.theme-action {
    font-size: 12px;
}

.theme-status {
    color: $muted;
    font-size: 12px;
    padding: 5px 0 0 6px;
}

.viewer {
    height: 100%;
    gap: 0;
    background: $bg;
}

.viewer-bar {
    gap: 6px;
    padding: 6px 12px;
    height: 32px;
    background: $surface;
    border-color: $line;
    border-width: 1px;
    align-items: center;
}

.viewer-title {
    font-weight: bold;
}

.viewer-meta {
    color: $muted;
    font-size: 12px;
}

.viewer-spacer {
    flex: 1;
}

.viewer-gap {
    width: 10px;
}

.view-button {
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 12px;
    color: $text;
    background: $line;
    cursor: pointer;

    &:hover {
        background: $hover;
        color: $blue;
    }
}

.view-button.on {
    background: $blue;
    color: $panel;
}

.view-button.off {
    color: $muted;
    background: $surface;
    cursor: default;
}

.zoom-level {
    width: 52px;
    text-align: center;
    white-space: nowrap;
}

.view-tabs,
.view-pager {
    gap: 4px;
    align-items: center;
}

.view-pager {
    padding: 0 0 0 12px;
}

.viewer-body {
    flex: 1;
    overflow: auto;
    overflow-x: auto;
}

.image-stage.fit {
    overflow-x: hidden;
}

.image-stage {
    background: $panel;
    padding: 24px;
    align-items: center;
}

.viewer-image {
    margin: 0 0 12px 0;
}

.viewer-hint {
    color: $muted;
    font-size: 11px;
    margin: 0;
}

.page-stack {
    background: $panel;
    padding: 16px 24px;
    align-items: center;
}

.pdf-page {
    margin: 0;
}

.page-number {
    color: $muted;
    font-size: 11px;
    margin: 4px 0 14px 0;
    text-align: center;
}

.viewer-status {
    margin: 0 0 8px 0;
    max-width: 640px;
}

.viewer-status.warn {
    color: $warn;
}

.tex-split {
    height: 100%;
    gap: 0;
}

.tex-split input_code.editor {
    flex: 1;
}

.tex-preview {
    width: 46%;
    border-color: $line;
    border-width: 1px;
}

.tex-preview.collapsed {
    width: 30px;
}

.tex-preview.collapsed {
    padding: 8px 4px;
    align-items: center;
}

.show-preview {
    padding: 6px 7px;
}

input_code.dump {
    flex: 1;
    margin: 0;
    border-radius: 0;
    background: $bg;
    padding: 6px 0;
}

.binary-info {
    padding: 16px 24px;
}

.fact {
    gap: 16px;
    padding: 4px 0;
}

.fact-label {
    width: 150px;
    color: $muted;
}

.fact-value {
    color: $text;
}

.info-heading {
    margin: 18px 0 6px 0;
    color: $blue;
    font-size: 13px;
}

.info-table {
    margin: 0;
    font-size: 12px;
    color: $text;
}

.page-stack.narrow {
    padding: 10px 12px;
}

.viewer-bar.sub-bar {
    background: $bg;
    height: 30px;
}

.style-toggle.spacer {
    border-color: rgba(0, 0, 0, 0);
}

.size-value {
    width: 90px;
}

.size-unit {
    width: 90px;
}

.font-select {
    width: 240px;
}

#output-log,
.out-chunk,
#problems,
#warnings {
    user-select: text;
}

.md-preview {
    width: 50%;
}

.md-body {
    background: $bg;
    padding: 14px 22px 40px 22px;
    gap: 0;
    user-select: text;
}

.md-h {
    color: $text;
    margin: 18px 0 8px 0;
}

.md-h1 {
    font-size: 26px;
}

.md-h2 {
    font-size: 21px;
}

.md-h3 {
    font-size: 17px;
}

.md-h4 {
    font-size: 15px;
}

.md-h5 {
    font-size: 13px;
}

.md-h6 {
    font-size: 13px;
    color: $muted;
}

.md-p {
    margin: 0 0 10px 0;
    line-height: 1.5;
}

.md-code {
    background: $panel;
    color: $text;
    border-color: $line;
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 12px;
    margin: 0 0 12px 0;
    font-size: 12px;
    overflow-x: auto;
}

.md-inline-code {
    background: $panel;
    color: $warn;
    font-size: 12px;
}

.md-link {
    color: $blue;
    cursor: pointer;

    &:hover {
        text-decoration: underline;
    }
}

.md-strike {
    text-decoration: line-through;
    color: $muted;
}

.md-quote {
    background: $surface;
    border-color: $line;
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 14px 0 14px;
    margin: 0 0 12px 0;
    color: $muted;
    gap: 0;
}

.md-list {
    margin: 0 0 10px 4px;
    gap: 2px;
}

.md-item {
    gap: 8px;
}

.md-marker {
    width: 22px;
    text-align: right;
    color: $muted;
}

.md-task .md-marker {
    color: $accent;
}

.md-item-body {
    flex: 1;
    gap: 0;
}

.md-item-body .md-p {
    margin: 0 0 2px 0;
}

.md-item-body .md-list {
    margin: 2px 0 2px 0;
}

.md-done .md-p {
    color: $muted;
}

.md-rule {
    margin: 10px 0 16px 0;
}

.md-table {
    border-color: $line;
    border-width: 1px;
    border-radius: 4px;
    margin: 0 0 12px 0;
    gap: 0;
}

.md-tr {
    gap: 0;
    border-color: $line;
    border-width: 1px;
}

.md-th {
    background: $surface;
    font-weight: bold;
}

.md-cell {
    flex: 1;
    padding: 4px 10px;
}

.md-cell-text {
    margin: 0;
}

.md-img {
    margin: 4px 0;
}

.md-missing {
    color: $error;
}

#stats {
    flex: 1;
    overflow: auto;
    padding: 6px 12px;
    gap: 8px;
    user-select: text;
}

.stats-title {
    color: $text;
    font-weight: bold;
}

.stats-columns {
    gap: 32px;
    align-items: flex-start;
}

.stats-table {
    gap: 2px;
    min-width: 260px;
}

.stats-heading {
    color: $muted;
    font-size: 11px;
    letter-spacing: 1px;
    margin: 0 0 2px 0;
}

.stats-row {
    gap: 12px;
}

.stats-label {
    color: $muted;
    min-width: 150px;
    white-space: pre;
}

.stats-value {
    color: $text;
}

#ports {
    gap: 0;
    flex: 1;
}

#ports-bar {
    gap: 8px;
    padding: 4px 10px;
    align-items: center;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.server-folder {
    min-width: 180px;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

.ports-label {
    color: $muted;
    font-size: 12px;
}

.server-port {
    width: 80px;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

#servers {
    flex: 1;
    overflow: auto;
    padding: 4px 10px;
    gap: 4px;
    user-select: text;
}

.server-row {
    gap: 10px;
    align-items: center;
    padding: 4px 6px;
    border-radius: 4px;

    &:hover {
        background: $hover;
    }
}

.server-dot {
    color: $muted;
    font-size: 10px;
}

.server-dot.on {
    color: $accent;
}

.server-url {
    color: $blue;
    cursor: pointer;
}

.server-folder-name {
    color: $text;
}

.server-meta {
    color: $muted;
    font-size: 12px;
}

#find-bar {
    gap: 4px;
    padding: 4px 10px;
    background: $surface;
}

#find-row,
#replace-row {
    gap: 6px;
    align-items: center;
}

.find-box {
    width: 320px;
    min-width: 80px;
    overflow: hidden;
}

.find-input {
    width: 100%;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

.find-indent {
    width: 18px;
}

.find-option {
    padding: 1px 6px;
    border-radius: 3px;
    color: $muted;
    font-family: monospace;
    font-size: 12px;
    cursor: pointer;

    &:hover {
        background: $hover;
        color: $text;
    }
}

.find-option.on {
    background: #3b4261;
    color: $blue;
}

.find-arrow {
    width: 18px;
    text-align: center;
    color: $text;
    cursor: pointer;
    border-radius: 3px;

    &:hover {
        background: $hover;
    }
}

.find-status {
    min-width: 90px;
    color: $muted;
    font-size: 12px;
}

.find-status.bad {
    color: $error;
}

.char-where {
    margin: 0 0 8px 0;
    font-size: 12px;
}

.char-button {
    margin: 0;
    padding: 3px 12px;
}

.char-row {
    gap: 8px;
    align-items: center;
}

.char-name {
    width: 120px;
}

.char-value {
    width: 150px;
}

.char-arrow {
    color: $muted;
}

.char-preview {
    color: $text;
    font-size: 13px;
}

.char-table-head {
    gap: 12px;
    padding: 4px 8px;
    color: $muted;
    font-size: 12px;
    font-weight: bold;
}

.char-category {
    gap: 8px;
    align-items: center;
    padding: 5px 8px;
    margin: 2px 0 0 0;
    border-radius: 4px;
    background: $hover;
    cursor: pointer;
}

.char-category.clash {
    background: #3a1f2b;
    color: $error;
}

.char-category-arrow {
    width: 12px;
}

.char-category-name {
    font-weight: bold;
}

.char-category-count {
    color: $muted;
    font-size: 12px;
}

.char-item {
    gap: 12px;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;

    &:hover {
        background: $hover;
    }
}

.char-item.clash {
    background: #3a1f2b;
}

.char-col-symbol {
    width: 64px;
    min-width: 64px;
    text-align: center;
    white-space: nowrap;
}

.char-col-code {
    width: 90px;
    white-space: nowrap;
}

.char-table-head .char-col-code {
    margin: 0 0 0 10px;
    width: 80px;
}

.char-col-names {
    flex: 1;
}

.char-col-yours {
    width: 160px;
}

.char-yours {
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

.char-glyph.invisible {
    color: $muted;
}

.char-result-name.bad {
    color: $error;
    font-weight: bold;
}

.char-row.clash {
    background: #3a1f2b;
    border-radius: 4px;
    padding: 6px;
}

.char-row.clash .char-name,
.char-name.bad {
    border-color: $error;
    color: $error;
}

.char-search {
    width: 320px;
    margin: 4px 0 6px 0;
}

#char-results {
    gap: 0;
}

.char-result {
    gap: 12px;
    align-items: center;
    padding: 3px 8px;
    border-radius: 4px;
    cursor: pointer;

    &:hover {
        background: $hover;
    }
}

.char-glyph {
    font-size: 18px;
}

.char-result-name {
    color: $blue;
}

.char-result-code {
    color: $muted;
    font-size: 12px;
}

#view-console {
    padding: 0;
    overflow: hidden;
}

#console {
    gap: 0;
    height: 100%;
}

#console-bar {
    gap: 8px;
    padding: 4px 10px;
    align-items: center;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.console-level {
    min-width: 150px;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

.console-filter-box {
    width: 200px;
    min-width: 60px;
    overflow: hidden;
}

.console-filter {
    width: 100%;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

#console-log {
    flex: 1;
    gap: 0;
    padding: 2px 0;
    overflow: auto;
    scroll-anchor: bottom;
    user-select: text;
}

#console-empty {
    padding: 8px 14px;
    gap: 2px;
}

#console-serve {
    color: $blue;
    cursor: pointer;
}

.console-row {
    gap: 8px;
    padding: 2px 10px;
    align-items: start;
    font-size: 12px;

    &:hover {
        background: $hover;
    }
}

.console-row.error {
    background: #3a1f2b;
    color: $error;
}

.console-row.warn {
    background: #3a3424;
    color: $warn;
}

.console-row.debug {
    color: $muted;
}

.console-row.note {
    color: $muted;
}

.console-row.input,
.console-row.result {
    color: $text;
}

.console-row.result {
    color: $blue;
}

.console-icon {
    width: 14px;
    font-size: 12px;
}

.console-text {
    flex: 1;
    margin: 0;
    font-family: monospace;
    font-size: 12px;
    white-space: pre-wrap;
}

.console-count {
    background: $line;
    color: $text;
    padding: 0 6px;
    border-radius: 8px;
    font-size: 11px;
}

.console-source {
    color: $muted;
    font-size: 12px;
}

.console-source.link {
    color: $blue;
    cursor: pointer;
}

#console-input-row {
    gap: 6px;
    padding: 3px 10px;
    align-items: center;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.console-prompt {
    color: $blue;
    font-weight: bold;
}

.console-input-box {
    flex: 1;
    min-width: 40px;
    overflow: hidden;
}

.console-input {
    width: 100%;
    margin: 0;
    padding: 3px 8px;
    font-family: monospace;
    font-size: 12px;
}

#view-elements {
    padding: 0;
    overflow: hidden;
}

#elements {
    gap: 0;
    height: 100%;
}

#elements-bar {
    gap: 8px;
    padding: 4px 10px;
    align-items: center;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.elements-page {
    min-width: 220px;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

.elements-note {
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
}

#elements-empty {
    padding: 8px 14px;
    gap: 2px;
}

#elements-serve {
    color: $blue;
    cursor: pointer;
}

#elements-body {
    flex: 1;
    gap: 0;
    min-height: 0;
}

#elements-tree {
    flex: 1;
    gap: 0;
    padding: 2px 0;
    overflow: auto;
    font-family: monospace;
    font-size: 12px;
}

.el-row {
    margin: 0;
    padding: 1px 8px 1px 4px;
    white-space: pre;
    font-family: monospace;
    font-size: 12px;
    cursor: default;

    &:hover {
        background: $hover;
    }
}

.el-row.selected {
    background: #33405e;
}

.el-twisty {
    color: $muted;
    cursor: pointer;
}

.el-punct {
    color: $muted;
    white-space: pre;
}

.el-tag {
    color: #cba6f7;
}

.el-attr {
    color: #fab387;
    white-space: pre;
}

.el-value {
    color: #a6e3a1;
    white-space: pre;
}

.el-text,
.el-text-inline {
    color: $text;
    white-space: pre;
}

.el-comment {
    color: $muted;
    white-space: pre;
}

.el-ellipsis {
    color: $muted;
    padding: 0 2px;
}

.el-more {
    color: $muted;
    padding: 4px 10px;
}

#elements-side {
    width: 42%;
    min-width: 240px;
    gap: 4px;
    padding: 4px 8px;
    border-left: 1px solid $line;
}

.elements-side-bar {
    align-items: center;
}

.elements-selected {
    color: $muted;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
}

.elements-html {
    flex: 1;
    min-height: 60px;
}

.elements-side-buttons {
    gap: 6px;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.md-block {
    gap: 0;
}

#view-git,
#view-history {
    padding: 0;
    overflow: hidden;
}

#git {
    gap: 0;
    height: 100%;
}

#git-main {
    flex: 5;
    gap: 4px;
    padding: 4px 10px 0 10px;
}

#git-bar,
#git-commit-row {
    gap: 6px;
    align-items: center;

    button {
        margin: 0;
        padding: 2px 10px;
        font-size: 12px;
    }
}

.git-branch {
    min-width: 110px;
    margin: 0;
    padding: 2px 8px;
    font-size: 12px;
}

.git-message-box,
.git-sync-box {
    flex: 1;
    min-width: 40px;
    overflow: hidden;
    white-space: nowrap;
}

.git-message {
    width: 100%;
    margin: 0;
    padding: 3px 8px;
    font-size: 12px;
}

.git-note {
    color: $muted;
    font-size: 12px;
}

.git-state {
    color: $blue;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
}

#git-state-row {
    gap: 10px;
    height: 15px;
}

#git-changes,
#git-tasks,
#git-log,
#git-branches,
#git-tags,
#history-list {
    flex: 1;
    overflow: auto;
    gap: 1px;
    padding: 0 0 6px 0;
}

#git-tasks-col {
    width: 250px;
    gap: 4px;
    padding: 4px 10px 0 10px;
    background: $surface;
}

#git-side {
    flex: 4;
    gap: 4px;
    padding: 4px 10px 0 10px;
}

.git-heading,
.git-section {
    gap: 8px;
    align-items: center;
    height: 22px;
}

.git-section {
    margin: 4px 0 0 0;
}

.git-title {
    color: $muted;
    font-size: 11px;
    font-weight: bold;
}

.git-file,
.git-commit,
.git-task,
.git-branch-row,
.git-tag-row,
.hist-row {
    user-select: none;
    gap: 8px;
    align-items: center;
    padding: 2px 6px;
    border-radius: 4px;
    cursor: pointer;

    &:hover {
        background: $hover;
    }

    .view-button {
        padding: 0 6px;
        font-size: 11px;
        white-space: nowrap;
    }
}

.view-button.danger:hover {
    color: $error;
}

.git-letter {
    width: 12px;
    font-weight: bold;
    font-size: 12px;
    color: $git-yellow;
}

.git-letter.git-added,
.git-letter.git-untracked {
    color: $git-green;
}

.git-letter.git-deleted,
.git-letter.git-conflict {
    color: $git-red;
}

.git-letter.git-renamed,
.git-letter.git-copied {
    color: $blue;
}

.git-name {
    white-space: nowrap;
    color: $git-yellow;
}

.git-name.git-added,
.git-name.git-untracked {
    color: $git-green;
}

.git-name.git-deleted {
    color: $git-red;
    text-decoration: line-through;
}

.git-name.git-conflict {
    color: $git-red;
}

.git-name.git-renamed,
.git-name.git-copied {
    color: $blue;
}

.git-view-tab {
    color: $muted;
    font-size: 11px;
    font-weight: bold;
    cursor: pointer;
    user-select: none;

    &:hover {
        color: $text;
    }
}

.git-view-tab.active {
    color: $text;
}

.git-subtitle {
    color: $muted;
    font-size: 10px;
    font-weight: bold;
    margin: 4px 0 0 0;
}

.git-branch-dot {
    width: 10px;
    color: $accent;
    font-size: 10px;
}

.git-branch-name,
.git-tag-name {
    white-space: nowrap;
}

.git-branch-row .git-meta,
.git-tag-row .git-meta {
    overflow: hidden;
}

.git-branch-row.current .git-branch-name {
    font-weight: bold;
}

.git-branch-name.protected {
    color: $warn;
}

.git-start {
    gap: 8px;
}

#git-repo {
    min-width: 110px;
}

#git-bar button {
    white-space: nowrap;
}

#explorer item.git-modified {
    color: $git-yellow;
}

#explorer item.git-added {
    color: $git-green;
}

#explorer item.git-conflict,
#explorer item.git-deleted {
    color: $git-red;
}

#explorer item.git-ignored {
    opacity: 0.5;
}

.git-dir,
.git-meta,
.git-task-summary {
    color: $muted;
    font-size: 11px;
    white-space: nowrap;
}

.git-task-text {
    gap: 0;
    flex: 1;
    overflow: hidden;
}

.git-task-summary {
    overflow: hidden;
}

.git-task-name {
    font-weight: bold;
    font-size: 12px;
}

.git-task-buttons {
    gap: 8px;
}

.view-button.git-task-more {
    margin: 6px 0 0 0;
}

.view-button.git-run {
    background: $blue;
    color: $panel;
    padding: 1px 10px;
}

.git-problem {
    color: $error;
    font-size: 11px;
    margin: 0;
}

.git-hash,
.hist-kind {
    font-family: monospace;
    font-size: 11px;
    color: $blue;
}

.hist-kind.local {
    color: $accent;
}

.git-refs {
    font-size: 10px;
    color: $panel;
    background: $warn;
    padding: 0 5px;
    border-radius: 3px;
    white-space: nowrap;
}

.git-subject,
.hist-label {
    white-space: nowrap;
    overflow: hidden;
}

.git-init {
    margin: 4px 0;
}

#history {
    gap: 0;
    height: 100%;
    padding: 4px 10px 0 10px;
}

#history-bar {
    gap: 10px;
    align-items: center;
    height: 24px;
}

.history-file {
    font-weight: bold;
}

.status-git {
    gap: 4px;
    align-items: center;
    cursor: pointer;
}

.diff-view,
.version-view {
    height: 100%;
    gap: 0;
    background: $bg;
}

.diff-bar {
    gap: 10px;
    padding: 6px 12px;
    height: 32px;
    background: $surface;
    border-color: $line;
    border-width: 1px;
    align-items: center;
}

.diff-title {
    font-weight: bold;
}

.diff-sub {
    color: $muted;
    font-size: 12px;
}

.diff-count {
    font-size: 12px;
    font-weight: bold;
}

.diff-count.add {
    color: $accent;
}

.diff-count.del {
    color: $error;
}

.diff-body {
    flex: 1;
    overflow: auto;
    overflow-x: auto;
    gap: 0;
    padding: 4px 0;
}

.diff-line {
    margin: 0;
    padding: 0 12px;
    font-size: 12px;
    white-space: pre;
}

.diff-add {
    background: #a6e3a126;
    color: $accent;
}

.diff-del {
    background: #f38ba826;
    color: $error;
}

.diff-hunk {
    color: $blue;
    background: $surface;
    margin: 6px 0 0 0;
}

.diff-file {
    font-weight: bold;
    color: $text;
    background: $line;
    padding: 3px 12px;
    margin: 10px 0 0 0;
}

.diff-meta {
    color: $muted;
}

.version-view input_code.editor {
    flex: 1;
}

.diff-hunk-row {
    gap: 6px;
    align-items: center;
    background: $surface;
    margin: 6px 0 0 0;
    padding: 0 12px 0 0;

    .diff-hunk {
        margin: 0;
        background: transparent;
    }

    .view-button {
        padding: 0 8px;
        font-size: 11px;
    }
}

#git-pickers {
    gap: 6px;
    align-items: center;
}

#view-git.narrow #git {
    display: block;
}

#view-git.narrow #git-main {
    flex: 3;
}

#view-git.narrow #git-tasks-col {
    width: 100%;
    max-height: 140px;
    overflow: auto;
}

#view-git.narrow #git-side {
    flex: 3;
}

#view-git.narrow .view-button.minor {
    display: none;
}

#status text {
    white-space: nowrap;
}

#view-terminal.narrow .terminal-picker {
    width: 140px;
    min-width: 80px;
}

.drag-preview {
    position: cursor;
    left: 16px;
    top: 14px;
    max-width: 340px;
    padding: 4px;
    background: $surface;
    border-color: $line;
    border-width: 1px;
    border-radius: 6px;
}

.drag-row {
    display: row;
    gap: 6px;
    padding: 2px 6px;
    white-space: nowrap;
}

.drag-more,
.drag-hint {
    color: $muted;
    padding: 2px 6px;
    white-space: nowrap;
}

.drag-hint {
    font-size: 11px;
}

#status-version {
    cursor: pointer;
}

.dev-view {
    height: 100%;
    gap: 0;
    background: $bg;
}

.dev-body {
    flex: 1;
    height: 100%;
    overflow: auto;
    padding: 14px 24px;
}

.dev-grid {
    gap: 16px;
    align-items: start;
}

.dev-column {
    flex: 1;
    min-width: 0;
}

.dev-card {
    background: $surface;
    border-color: $line;
    border-width: 1px;
    border-radius: 6px;
    padding: 10px 14px;
    margin: 0 0 14px 0;
}

.dev-card-title {
    color: $blue;
    font-weight: bold;
    margin: 0 0 6px 0;
}

.dev-row {
    gap: 12px;
    padding: 3px 0;
}

.dev-label {
    width: 150px;
    color: $muted;
}

.dev-value-box {
    flex: 1;
    gap: 3px;
}

.dev-bar {
    height: 4px;
    background: $line;
    border-radius: 2px;
}

.dev-bar-fill {
    height: 4px;
    background: $accent;
    border-radius: 2px;
}
