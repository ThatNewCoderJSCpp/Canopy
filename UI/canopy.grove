<!grove>
<grove>
    <head>
        <title>Canopy</title>
        <style src="canopy.bark" />
    </head>
    <body title="Canopy">
        <row id="shell">
            <column id="sidebar" class="area" data-area="sidebar">
                <row id="sidebar-tabs" class="area-tabs" data-area="sidebar">
                    <text class="panel-tab active" id="tab-explorer" data-view="explorer">EXPLORER</text>
                </row>
                <panel id="view-explorer" class="panel-view active">
                <p id="workspace-name" class="workspace">No folder open</p>
                <row class="sidebar-actions">
                    <input_file id="open-folder" mode="folder" title="Open a folder" hide-value>Open Folder…</input_file>
                    <input_file id="add-folder" mode="folder" title="Add another folder to this workspace" hide-value>Add Folder…</input_file>
                </row>
                <row class="sidebar-actions">
                    <input_file id="open-file" mode="open" title="Open a file" hide-value>Open File…</input_file>
                </row>
                <list id="explorer" tabindex="0" title="Right-click for more; drag to move, Ctrl+drag to copy"></list>
                <p class="sidebar-title section">RECENT FOLDERS</p>
                <list id="recent"></list>
                <row class="sidebar-footer">
                    <button id="open-settings">Settings</button>
                </row>
                </panel>
            </column>
            <column id="main">
                <row id="tab-bar">
                    <row id="tabs"></row>
                    <row id="tab-actions">
                        <button id="build-button">Build</button>
                        <button id="run-button" class="primary">Run</button>
                    </row>
                </row>
                <panel id="editors">
                    <panel id="welcome">
                        <h2>Welcome to Canopy</h2>
                        <p class="muted">Open a folder or a file from the explorer to start editing.</p>
                        <p>C, C++, Walnut and Grove build out of the box: press <b>Build</b> or <b>Run</b> above, or <code>Ctrl+B</code> and <code>F5</code>.</p>
                        <p><link id="welcome-settings">Settings</link> (<code>Ctrl+,</code>) has a page for the editor, colors and themes, compilers and building. Everything is saved as Bark files you can also edit by hand.</p>
                    </panel>
                </panel>
            </column>
            <column id="panel" class="area" data-area="panel">
                    <row id="panel-tabs" class="area-tabs" data-area="panel">
                        <text class="panel-tab" id="tab-terminal" data-view="terminal">TERMINAL</text>
                        <text class="panel-tab active" id="tab-problems" data-view="problems">PROBLEMS</text>
                        <text class="panel-tab" id="tab-warnings" data-view="warnings">WARNINGS</text>
                        <text class="panel-tab" id="tab-output" data-view="output">OUTPUT</text>
                        <text class="panel-tab" id="tab-git" data-view="git">GIT</text>
                        <text class="panel-tab" id="tab-history" data-view="history">HISTORY</text>
                        <text class="panel-tab" id="tab-ports" data-view="ports">PORTS</text>
                        <text class="panel-tab" id="tab-debug" data-view="debug">DEBUG CONSOLE</text>
                    </row>
                    <panel id="view-terminal" class="panel-view">
                        <column id="terminal">
                            <row id="terminal-bar">
                                <input_select id="terminal-picker" class="terminal-picker" title="Terminals, one per workspace folder"><option value="">No terminal</option></input_select>
                                <button id="terminal-new" title="New terminal in this terminal's folder">+ New</button>
                                <button id="terminal-clear" title="Clear the terminal (Ctrl+L)">Clear</button>
                                <button id="terminal-kill" title="Close this terminal and stop its shell">Kill</button>
                            </row>
                            <column id="terminal-views">
                                <p id="terminal-empty" class="muted hidden">No terminal is open. Press + New to start one.</p>
                            </column>
                        </column>
                    </panel>
                    <panel id="view-problems" class="panel-view active">
                        <panel id="problems"></panel>
                    </panel>
                    <panel id="view-warnings" class="panel-view">
                        <panel id="warnings"></panel>
                    </panel>
                    <panel id="view-output" class="panel-view">
                        <pre id="output-log">Build and run output shows up here.</pre>
                    </panel>
                    <panel id="view-git" class="panel-view">
                        <row id="git">
                            <column id="git-main">
                                <row id="git-pickers" class="hidden"></row>
                                <row id="git-bar">
                                    <input_select id="git-repo" class="git-branch" title="The repository the Git tab shows"><option value="">No repository</option></input_select>
                                    <input_select id="git-branch" class="git-branch" title="The branch you're on; pick another to switch to it"><option value="">No repository</option></input_select>
                                    <div class="viewer-spacer"></div>
                                    <button id="git-fetch" title="Fetch every remote (git fetch --all --prune)">Fetch</button>
                                    <button id="git-pull" title="Pull the current branch (git pull)">Pull</button>
                                    <button id="git-push" title="Push the current branch; publishes it with -u the first time">Push</button>
                                    <button id="git-more" title="Branches, merging, tags, stashes, undo and the tasks file">More</button>
                                </row>
                                <row id="git-commit-row">
                                    <div class="git-message-box"><input_string id="git-message" class="git-message" placeholder="Commit message" title="Enter commits; Ctrl+Enter commits and pushes" /></div>
                                    <button id="git-commit" class="primary" title="Commit the staged files, or every change if nothing is staged">Commit</button>
                                    <button id="git-commit-push" title="Commit, then push the branch">Commit &amp; Push</button>
                                </row>
                                <row id="git-state-row">
                                    <text id="git-sync" class="git-note"></text>
                                    <text id="git-state" class="git-state"></text>
                                </row>
                                <column id="git-changes"></column>
                            </column>
                            <column id="git-tasks-col">
                                <row class="git-heading">
                                    <text class="git-title">TASKS</text>
                                    <div class="viewer-spacer"></div>
                                    <text id="git-tasks-edit" class="view-button" title="Open .canopy/tasks.bark">Edit</text>
                                </row>
                                <column id="git-tasks"></column>
                            </column>
                            <column id="git-side">
                                <row class="git-heading">
                                    <text id="git-view-commits" class="git-view-tab active" data-git-view="commits">COMMITS</text>
                                    <text id="git-view-branches" class="git-view-tab" data-git-view="branches">BRANCHES</text>
                                    <text id="git-view-tags" class="git-view-tab" data-git-view="tags">TAGS</text>
                                    <text id="git-log-note" class="git-note"></text>
                                    <div class="viewer-spacer"></div>
                                    <text id="git-side-add" class="view-button hidden" data-git-add="branch">+ New Branch</text>
                                </row>
                                <column id="git-log" title="Click a commit to see its changes; right-click for more"></column>
                                <column id="git-branches" class="hidden"></column>
                                <column id="git-tags" class="hidden"></column>
                            </column>
                        </row>
                    </panel>
                    <panel id="view-history" class="panel-view">
                        <column id="history">
                            <row id="history-bar">
                                <text id="history-file" class="history-file">No file</text>
                                <text id="history-note" class="git-note"></text>
                            </row>
                            <column id="history-list"></column>
                        </column>
                    </panel>
                    <panel id="view-ports" class="panel-view">
                        <column id="ports">
                            <row id="ports-bar">
                                <input_select id="server-folder" class="server-folder" title="The folder to serve"><option value="">Workspace folder</option></input_select>
                                <text class="ports-label">Port</text>
                                <input_integer id="server-port" class="server-port" value="5500" min="1" max="65535" title="The port to try first; the next free one is used if it's busy" />
                                <input_bool id="server-reload" checked title="Reload open pages when you save a file in the folder">Live reload</input_bool>
                                <button id="server-start" class="primary" title="Serve the folder's HTML on localhost">Start Server</button>
                            </row>
                            <column id="servers">
                                <p class="muted">No local servers. Pick a folder and press Start Server to serve its HTML at http://localhost.</p>
                            </column>
                        </column>
                    </panel>
                    <panel id="view-debug" class="panel-view">
                        <p class="muted">The debugger isn't built yet. Debug output and expressions will show up here.</p>
                    </panel>
            </column>
            <column id="aside" class="area hidden" data-area="aside">
                <row id="aside-tabs" class="area-tabs" data-area="aside"></row>
            </column>
        </row>
        <row id="status">
            <row class="status-left">
                <text id="status-workspace">No folder</text>
                <text id="status-problems">0 problems</text>
                <row id="status-git" class="status-git hidden" title="Git branch; click for the Git tab">
                    <text id="status-branch"></text>
                </row>
            </row>
            <row class="status-right">
                <input_select id="theme-picker" class="status-select" title="Color theme"><option value="canopy-dark">Canopy Dark</option></input_select>
                <text id="status-cursor"></text>
                <text id="status-language"></text>
                <text id="status-toolchain">detecting toolchain</text>
                <text id="status-version">Canopy</text>
            </row>
        </row>
        <column id="drag-preview" class="drag-preview hidden"></column>
    </body>
</grove>
