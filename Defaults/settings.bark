// Canopy's built-in settings.
//
// Settings are Bark, the same language Grove apps are styled with.
// Each block is a section and each line is one setting. To change one, copy
// just that line into your own settings file (run `canopy settings --edit`
// to open it) inside the same block. Anything you don't set keeps the value
// below. A workspace can override both with .canopy/settings.bark.
//
// `canopy settings` lists every value in effect and the file and line it
// came from.

editor {
    font-family: "monospace";
    font-size: 14px;
    tab-size: 4;
    insert-spaces: true;
    line-numbers: true;
    word-wrap: false;
    theme: "canopy-dark";
}

// Where each tool comes from. `auto` means: the copy shipped next to Canopy,
// then your PATH, then the usual install folders (MSYS2 on Windows).
// Put a full path here to use a particular one.
toolchain {
    c: auto;
    cpp: auto;
    walnut: auto;
    grove: auto;
}

language.c {
    standard: "c17";
    flags: "-Wall -Wextra";
    debug-flags: "-g -O0";
    release-flags: "-O2";
}

language.cpp {
    standard: "c++17";
    flags: "-Wall -Wextra -Wpedantic";
    debug-flags: "-g -O0";
    release-flags: "-O2";
}

language.walnut {
    flags: "";
    debug-flags: "-g";
    release-flags: "-O2";
}

language.grove {
    flags: "";
}

build {
    mode: debug;
    output-dir: "build";
    save-before-build: true;
}
