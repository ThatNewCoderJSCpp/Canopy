toolchain {
    c: auto;
    cpp: auto;
    walnut: auto;
    grove: auto;
}

language.c {
    standard: "c17";
    flags: "-Wall -Wextra";
    debug-flags: "-g -O0";
    release-flags: "-O2";
}

language.cpp {
    standard: "c++17";
    flags: "-Wall -Wextra -Wpedantic";
    debug-flags: "-g -O0";
    release-flags: "-O2";
}

language.walnut {
    flags: "";
    debug-flags: "-g";
    release-flags: "-O2";
}

language.grove {
    flags: "";
}
