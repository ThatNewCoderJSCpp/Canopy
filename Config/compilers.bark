toolchain {
    c: auto;
    cpp: auto;
    walnut: auto;
    grove: auto;
    node: auto;
    zig: auto;
    rustc: auto;
    cargo: auto;
    python: auto;
    lua: auto;
    luac: auto;
    java: auto;
    javac: auto;
    dotnet: auto;
    mcs: auto;
    mono: auto;
    nasm: auto;
    yasm: auto;
    fasm: auto;
    masm: auto;
}

language.c {
    standard: "c17";
    flags: "-Wall -Wextra";
    debug-flags: "-g -O0";
    release-flags: "-O2";
}

language.cpp {
    standard: "c++17";
    flags: "-Wall -Wextra -Wpedantic";
    debug-flags: "-g -O0";
    release-flags: "-O2";
}

language.walnut {
    flags: "";
    debug-flags: "-g";
    release-flags: "-O2";
    checks: "off";
    leak-check: "off";
    gc: false;
    ownership: false;
}

language.grove {
    flags: "";
}

language.rust {
    edition: "2021";
    flags: "";
    debug-flags: "";
    release-flags: "";
}

language.zig {
    flags: "";
    debug-flags: "";
    release-flags: "";
}

language.python {
    flags: "";
}

language.java {
    flags: "";
    debug-flags: "";
    release-flags: "";
}

language.csharp {
    flags: "";
}

language.asm {
    dialect: auto;
    arch: auto;
    flags: "";
    debug-flags: "";
    release-flags: "";
}
